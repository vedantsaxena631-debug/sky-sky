PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/skybridge
ADMIN_API_KEY=replace-with-long-random-string
OPERATOR_API_KEY=replace-with-another-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# A device is ONLINE only if a valid heartbeat arrived within this window
DEVICE_TIMEOUT_MS=60000
# Messages not delivered within this window are marked failed
MESSAGE_TTL_MS=600000
